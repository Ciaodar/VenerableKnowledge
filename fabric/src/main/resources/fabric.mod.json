{
    "schemaVersion": 1,
    "id": "venerable_knowledge",
    "version": "${version}",
    "name": "Effect of Venerable Knowledge",
    "description": "Adds the Effect of Venerable Knowledge and Experience Potions to Minecraft.",
    "authors": [
        "Ciaodar"
    ],
    "contact": {
        "homepage": "https://github.com/Ciaodar/VenerableKnowledge",
        "sources": "https://github.com/Ciaodar/VenerableKnowledge",
        "issues": "https://github.com/Ciaodar/VenerableKnowledge/issues"
    },
    "license": "MIT",
    "icon": "assets/venerable_knowledge/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.venerableknowledge.fabric.VenerableKnowledgeFabric"
        ],
        "client": [
            "com.venerableknowledge.fabric.client.VenerableKnowledgeFabricClient"
        ]
    },
    "mixins": [
        "venerable_knowledge.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.10",
