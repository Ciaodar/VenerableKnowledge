{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {},
    "license": "${license}",
    "icon": "icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.venerableknowledge.fabric.VenerableKnowledgeFabric"
        ]
    },
    "mixins": [
        "venerable_knowledge.mixins.json",
        "venerable_knowledge.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": ">=1.21 <1.22",
        "java": ">=21"
    }
}
